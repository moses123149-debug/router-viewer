<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="18dp"
    android:paddingEnd="36dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="데이터 한도 설정"
        android:textColor="@color/fg"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView style="@style/Label" android:labelFor="@+id/etLimit" android:textSize="13sp" android:text="월 데이터 한도 (GB)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMinus"
                    style="@style/PillButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/box"
                    android:contentDescription="한도 10 GB 줄이기"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="−"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etLimit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/box"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="5"
                    android:textColor="@color/accent"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/PillButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/box"
                    android:contentDescription="한도 10 GB 늘리기"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="+"
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="원형 그래프가 가득 차는 기준입니다. 요금제의 핫스팟 제공량에 맞춰 입력합니다." />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1">

            <TextView style="@style/Label" android:labelFor="@+id/npDay" android:textSize="13sp" android:text="사용량 기준일 (매월)" />

            <NumberPicker
                android:id="@+id/npDay"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1" />

            <TextView
                style="@style/Label"
                android:lineSpacingMultiplier="1.3"
                android:text="이 날짜에 이번 달 사용량이 0으로 돌아갑니다." />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1">

            <TextView style="@style/Label" android:labelFor="@+id/etUsed" android:textSize="13sp" android:text="이번 달 사용량 보정 (GB)" />

            <EditText
                android:id="@+id/etUsed"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/box"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="8"
                android:textColor="@color/fg"
                android:textColorHint="@color/dim"
                android:textSize="22sp" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="폰이 센 값과 통신사 집계가 다를 때, 통신사 앱에 보이는 수치를 입력해 맞춥니다. 비워 두면 바꾸지 않습니다." />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="@style/PillButton"
            android:layout_marginEnd="10dp"
            android:text="취소" />

        <Button
            android:id="@+id/btnSave"
            style="@style/PillButton"
            android:background="@drawable/pill_fill"
            android:text="저장"
            android:textColor="@color/bg"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
